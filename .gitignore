.env.*
private/
admin/config.php
admin/config.php.bak

# local backups written by the admin panel
data/*.bak
data/*.tmp
data/menu.backup.json

# editor, OS and log files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
.claude/

# local working folders for big original photos
originals/
